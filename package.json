{
  "name": "polish-mcp-servers",
  "version": "0.1.2",
  "description": "MCP stdio server for Polish public law and registers. Lists 14 Apify Actor tools without a token and runs them with APIFY_TOKEN.",
  "license": "MIT",
  "author": "Kamil Kaczmarek",
  "homepage": "https://github.com/kamilkaczmareksolutions/polish-mcp-servers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamilkaczmareksolutions/polish-mcp-servers.git"
  },
  "bugs": {
    "url": "https://github.com/kamilkaczmareksolutions/polish-mcp-servers/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "poland",
    "polish",
    "apify",
    "open-data",
    "eli",
    "saos",
    "cepik",
    "krs",
    "regon",
    "nip"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "polish-mcp-servers": "dist/main.js",
    "polish-mcp": "dist/main.js",
    "polish-law-mcp": "dist/law.js",
    "polish-public-registers": "dist/registers.js"
  },
  "files": [
    "dist",
    "catalog",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test dist/stdio.test.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  }
}
